{
  "name": "smart-mine-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "金属及非金属矿山智能化综合管控平台 — WebGIS 大屏系统",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
