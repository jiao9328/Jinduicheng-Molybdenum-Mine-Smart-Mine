# 环境变量样例。复制成 .env 再按需改：cp .env.example .env
#
# 全部都是可选的 —— 一个都不配，项目也能跑：底图走 public/map-tiles 的离线瓦片，
# 接口不可用时降级到内置数据。下面这几个是「想开某个能力」时才要动的开关。
# 逐项含义与默认值见 README「环境变量」一节。

# REST 接口前缀。不配则用 /api
# VITE_API_BASE_URL=/api

# WebSocket 地址。默认**关闭**，不配就不建立任何连接，页面改用轮询兜底
# VITE_WS_URL=ws://localhost:8080/ws

# 接口不可用时是否降级到内置数据。生产环境建议设 false
# VITE_ALLOW_MOCK_FALLBACK=true

# 是否用在线实景三维替代程序化场景（需外网 + 商用授权）
# VITE_USE_ONLINE_3D=false

# Cesium Ion 令牌，配合上面一项使用。
# ⚠️ 前端可见，务必在 Ion 后台配域名白名单，别当密钥用。
# VITE_CESIUM_ION_TOKEN=

# ---------------------------------------------------------------------------
# 墩儿（AI 助手）—— 后端读，**不进前端包**
# ---------------------------------------------------------------------------
#
# ⚠️ 这三个**故意不带 `VITE_` 前缀**，不是笔误。
# vite 会把 `VITE_*` 的变量内联进前端产物，任何访客打开 devtools 都能读到；
# 而 `VITE_CESIUM_ION_TOKEN` 那种"前端可见"的令牌是设计如此。
# 模型密钥不是 — 它一旦进了包就等于公开。
# 少了前缀还有一层好处：命名本身就能看出「它不会进前端」。

# DeepSeek（或任何 OpenAI 兼容接口）的 API key。
# **不配也能跑** —— 墩儿会走离线规则引擎，导航/图层/查询这些核心指令
# 100% 可用，只是"长尾说法"认不出来时会如实说没听懂，不猜。
# DUNER_LLM_KEY=sk-xxxxxxxx

# 模型名。必须是支持 function calling 的；实测 deepseek-v4-flash 可用，
# deepseek-v4-pro 会返回 HTTP 200 + 空内容（看着成功，其实什么也没说）。
# DUNER_LLM_MODEL=deepseek-v4-flash

# 接口地址。换任何 OpenAI 兼容服务（含本地 Ollama/vLLM）都只改这一行。
# DUNER_LLM_BASE_URL=https://api.deepseek.com

# 模型调用超时（毫秒）。**必须明显小于前端 http.ts 的 15000ms** ——
# 后端比前端慢的话前端先超时，用户看到"请求失败"而后端还在跑、还在写审计。
# DUNER_LLM_TIMEOUT_MS=8000

# 一键关掉模型（保留规则引擎）。想验证"离线也能用"时设 false。
# DUNER_LLM_ENABLED=true

# 写操作确认令牌的有效期（毫秒），默认 60000。指导书 4.4 定的是 60 秒。
# DUNER_CONFIRM_TTL_MS=60000

# 规则引擎的置信度门槛（0~1），低于它才去问模型。调高 = 更常问模型，
# 调低 = 更信规则。想观察模型那条路时可以调到 0.99。
# DUNER_CONFIDENCE=0.8
