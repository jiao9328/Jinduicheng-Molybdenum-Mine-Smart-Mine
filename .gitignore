node_modules
dist
dist-ssr
*.local
*.tsbuildinfo

# 环境变量：含 Cesium Ion token 等凭据，绝不入库
.env
.env.local
.env.*.local

# Cesium 静态资源由 postinstall 从 node_modules 拷贝，不入库
public/cesium
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea
*.log
src/types/auto-imports.d.ts
src/types/components.d.ts

# ---- 数据库文件，不是源码 ----
#
# SQLite 库（含 WAL 与 shm 两个伴生文件）由 `npm run db:seed` 生成，
# 内容全部来自 src/mock/*.ts —— 也就是说**它完全可以重新生成**，
# 没有任何一条信息是只存在于库里的。入库只会把二进制脏数据带进
# 版本历史（每改一行就重新落一份整库，git 无法增量压缩）。
# 另外它装的是 users 表，口令哈希与盐也不该进库。
server/data/

# ---- 巡检脚本的产出，不是源码 ----
#
# 两者都由 scripts/ 下的脚本每次运行时重新生成，体积还大
#（.snapshots 14M、_out 里单张截图 2M 上下），入库只会让仓库虚胖。
.snapshots/
_out/

# ---- 甲方参考资料，不是程序的一部分 ----
#
# 设计效果图、需求文档、原始打包文件（含一个 39M 的 .rar），合计 44M。
# 这些是**输入**不是**产出**：程序里没有任何代码读它们，
# 而仓库要装的是可运行的工程。留在本地备查即可。
参考/
